; ══════════════════════════════════════════════════════════
;  dex-file.inc — the header, the map, and the order of sections
;
;  A dex file is a header, then sections in a fixed order, then a
;  map that says where each of them went and how many items it held.
;  The header cannot be written until the sizes are known and the
;  map cannot be written until the offsets are, so both are laid out
;  as labels and filled in by the assembler.
;
;  The map is built rather than declared: whichever sections turned
;  out to be non-empty are counted and listed.  Getting that count
;  wrong is the kind of mistake that produces a file the verifier
;  rejects with nothing useful to say, so it is derived, never
;  written.
; ══════════════════════════════════════════════════════════

; ── DEX file scaffolding ─────────────────────────────────
;
;  Usage inside postpone block:
;
;      postpone
;      __global::
;          dex_header
;
;          string_ids:
;              ...
;          type_ids:
;              ...
;          ...
;          data:
;              ...
;
;          dex_footer
;      end postpone
;
;  field_ids is optional: if the label is not defined,
;  the header emits zeroes for field_ids_size / field_ids_off.

macro dex_header?
    header:
        emit $08 : DEX_FILE_MAGIC       ; 8 raw bytes, not one field
    header_magic_end:
        uint $00
    header_adler32:
        emit $14 : $00
    header_sha1:
        uint (header_end - header)          ; file_size
        uint (string_ids - header)          ; header_size
        uint ENDIAN_CONSTANT
        uint $00                            ; link_size
        uint $00                            ; link_off
        uint _map                           ; map_off
        uint string_ids_size
        uint (string_ids  - header)
        uint type_ids_size
        uint (type_ids    - header)
        uint proto_ids_size
        uint (proto_ids   - header)
        if defined field_ids
            uint field_ids_size
            uint (field_ids - header)
        else
            uint $00
            uint $00
        end if
        uint method_ids_size
        uint (method_ids  - header)
        uint class_defs_size
        uint (class_defs  - header)
        uint (link_data   - data)           ; data_size
        uint (data        - header)         ; data_off
end macro

macro dex_footer?
    link_data:
    header_end:

    emit_checksums
end macro

; ── The file ─────────────────────────────────────────────
;
;      dex_lists _class, _types, _methods, _code
;      dex_file
;
;  The layout is the same every time, so it is written once here.
;  The one thing that varies is the list of interfaces a class
;  implements, which goes in a macro handed to dex_file.

macro dex_file? interfaces?
    postpone
    __global::
        count_fields
        dex_header

        string_ids:
            emit_string_ids
        type_ids:
            emit_type_ids
        proto_ids:
            emit_proto_ids
        if __deffield_count > $00
            field_ids:
                emit_field_ids
        end if
        method_ids:
            emit_method_ids
        class_defs:
            emit_class_defs

        data:
            data_strings:
                emit_string_data
            align $04
            data_type_lists:
                emit_proto_type_lists
            align $04
            match , interfaces
            else
                interfaces
            end match
            align $04
            data_class_data:
                repeat __class_count k:$00
                    __class_data_#k defclassdata k
                end repeat
            align $04
            data_code:
                emit_code
            dex_map_list
        dex_footer
    end postpone
end macro

; ── Automatic map_list ───────────────────────────────────
;
;  Usage (replaces manual map_list in data section):
;
;      data_code:
;          _hw_init_code code_item ...
;          ...
;
;      dex_map_list
;
;  Requires standard labels in data section:
;      data_strings:      (before first defstring/emit_string_data)
;      data_type_lists:   (before first type_list)
;      data_class_data:   (before first class_data_item)
;      data_code:         (before first code_item)
;      data_map:          (generated by this macro)
;
;  field_ids, type_list and code_item entries are emitted only
;  when present, and counted the same way.

macro emit_map_item? _type?*, _size?*, _offset?*
    ushort _type
    ushort $00
    uint _size
    uint _offset
end macro

macro dex_map_list?
    local count
    ; always present: header, string_id, type_id, proto_id, method_id,
    ; class_def, string_data, class_data, map_list
    count = $09
    if defined field_ids
        count = count + $01
    end if
    if __type_list_count > $00
        count = count + $01
    end if
    if __code_item_count > $00
        count = count + $01
    end if

    align $04
    data_map:
    _map:
        uint count
        emit_map_item TYPE_HEADER_ITEM,       $01,               header
        emit_map_item TYPE_STRING_ID_ITEM,    string_ids_size,   string_ids
        emit_map_item TYPE_TYPE_ID_ITEM,      type_ids_size,     type_ids
        emit_map_item TYPE_PROTO_ID_ITEM,     proto_ids_size,    proto_ids
        if defined field_ids
            emit_map_item TYPE_FIELD_ID_ITEM, field_ids_size,    field_ids
        end if
        emit_map_item TYPE_METHOD_ID_ITEM,    method_ids_size,   method_ids
        emit_map_item TYPE_CLASS_DEF_ITEM,    class_defs_size,   class_defs
        emit_map_item TYPE_STRING_DATA_ITEM,  string_ids_size,   data_strings
        if __type_list_count > $00
            emit_map_item TYPE_TYPE_LIST,     __type_list_count, data_type_lists
        end if
        emit_map_item TYPE_CLASS_DATA_ITEM,   class_defs_size,   data_class_data
        if __code_item_count > $00
            emit_map_item TYPE_CODE_ITEM,     __code_item_count, data_code
        end if
        emit_map_item TYPE_MAP_LIST,          $01,               data_map

    align $04
end macro
